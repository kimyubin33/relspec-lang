{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RelSpec",
  "scopeName": "source.kpl",
  "patterns": [
    {
      "include": "#item"
    },
    {
      "include": "#reference-definition"
    },
    {
      "include": "#body-text"
    },
    {
      "include": "#sentence-note"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#declaration-list"
    },
    {
      "include": "#declaration-optional"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#label"
    },
    {
      "include": "#citation"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "reference-definition": {
      "comment": "참조 1: 본문. 본문 안의 #은 주석이 아닙니다.",
      "match": "^\\s*(참조)\\s+([0-9]+)\\s*(:)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.kpl"
        },
        "2": {
          "name": "constant.numeric.reference.kpl"
        },
        "3": {
          "name": "punctuation.separator.kpl"
        },
        "4": {
          "name": "string.unquoted.reference.kpl"
        }
      }
    },
    "body-text": {
      "comment": "본문: 글. 글 안의 #은 주석이 아닙니다.",
      "match": "^\\s*(본문)\\s*(:)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.kpl"
        },
        "2": {
          "name": "punctuation.separator.kpl"
        },
        "3": {
          "name": "string.unquoted.body.kpl"
        }
      }
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.kpl"
    },
    "declaration": {
      "comment": "줄을 시작하는 낱말과 선언하는 이름 하나",
      "match": "^\\s*(정의|기준|사건|관측|규칙)(?:\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*))?(?![\\p{L}\\p{N}\\p{M}_])",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.kpl"
        },
        "2": {
          "name": "entity.name.function.kpl"
        }
      }
    },
    "label": {
      "comment": "이름 붙은 문장: 깨짐: 컵이 떨어지면 ...",
      "match": "^\\s*([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)\\s*(:)",
      "captures": {
        "1": {
          "name": "entity.name.function.kpl"
        },
        "2": {
          "name": "punctuation.separator.kpl"
        }
      }
    },
    "citation": {
      "comment": "문장 끝의 (참조 1, 참조 2)",
      "begin": "\\((?=\\s*참조(?![\\p{L}\\p{N}_]))",
      "end": "\\)",
      "name": "meta.citation.kpl",
      "patterns": [
        {
          "match": "(참조)\\s+([0-9]+)",
          "captures": {
            "1": {
              "name": "keyword.other.reference.kpl"
            },
            "2": {
              "name": "constant.numeric.reference.kpl"
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.kpl"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "comment": "수와 단위, 정도",
          "match": "(?<![\\p{L}\\p{N}_])([0-9]+)\\s*(밀리초|초|밀리미터|센티미터|미터|%)?(?![\\p{L}\\p{N}_])",
          "captures": {
            "1": {
              "name": "constant.numeric.kpl"
            },
            "2": {
              "name": "keyword.other.unit.kpl"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(정수|논리|시간|거리|시각|위치|정도|시간축|위치축)(?![\\p{L}\\p{N}_])",
          "name": "support.type.kpl"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(참|거짓)(?![\\p{L}\\p{N}_])",
          "name": "constant.language.kpl"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(그리고|또는|아님)(?![\\p{L}\\p{N}_])",
          "name": "keyword.operator.logical.kpl"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(이면|최소로|곱으로)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.rule.kpl"
        },
        {
          "comment": "지시어: 참조가 필요합니다.",
          "match": "(?<![\\p{L}\\p{N}_])(이렇게|그렇게|저렇게|(?:이것|그것|저것)(?:이|가|은|는|을|를|에게|한테|으로|로)?)(?![\\p{L}\\p{N}_])",
          "name": "variable.language.demonstrative.kpl"
        },
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.kpl"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.kpl"
        },
        {
          "match": "\\+|-|\\*",
          "name": "keyword.operator.arithmetic.kpl"
        },
        {
          "match": "@",
          "name": "keyword.operator.anchor.kpl"
        },
        {
          "match": "\\?",
          "name": "constant.language.unknown.kpl"
        },
        {
          "match": "[:,.]",
          "name": "punctuation.separator.kpl"
        }
      ]
    },
    "declaration-list": {
      "comment": "쉼표로 여러 이름을 선언하는 줄. ':'나 '=' 앞까지의 이름이 모두 선언입니다. 괄호 안은 행위의 활용형입니다.",
      "begin": "^\\s*(대상|단위|미지|행위)(?![\\p{L}\\p{N}\\p{M}_])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.kpl"
        }
      },
      "end": "(?=[:=#]|$)",
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)|(?=$)",
          "name": "meta.forms.kpl",
          "patterns": [
            {
              "match": ",",
              "name": "punctuation.separator.kpl"
            }
          ]
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*",
          "name": "entity.name.function.kpl"
        },
        {
          "match": ",",
          "name": "punctuation.separator.kpl"
        }
      ]
    },
    "declaration-optional": {
      "comment": "검사·조건·목표. 이름은 바로 뒤에 '='(비교 '=='가 아닌)가 올 때만 이름입니다.",
      "match": "^\\s*(검사|조건|목표)(?![\\p{L}\\p{N}\\p{M}_])(?:\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)(?=\\s*=(?!=)))?",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.kpl"
        },
        "2": {
          "name": "entity.name.function.kpl"
        }
      }
    },
    "sentence-note": {
      "comment": "문장 뒤의 ': 설명'. 설명은 글이므로 안의 수와 기호를 식처럼 색칠하지 않습니다. 줄 처음 낱말 바로 뒤의 ':'는 문장의 이름입니다.",
      "match": "^(\\s*(?!(?:정의|검사|기준|대상|단위|사건|미지|조건|목표|관측|행위|규칙|참조|본문)(?![\\p{L}\\p{N}\\p{M}_]))(?:[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*\\s*:\\s*)?[^\\s:#]+\\s[^:#]*)(:)(.*)$",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#label"
            },
            {
              "include": "#citation"
            },
            {
              "include": "#expression"
            }
          ]
        },
        "2": {
          "name": "punctuation.separator.kpl"
        },
        "3": {
          "name": "string.unquoted.note.kpl"
        }
      }
    },
    "item": {
      "comment": "- 글. 위의 문장·참조·본문에 딸린 줄입니다.",
      "match": "^\\s*(-)(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.list.kpl"
        },
        "2": {
          "name": "string.unquoted.item.kpl"
        }
      }
    }
  }
}
