{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AHAA",
  "scopeName": "source.aha",
  "patterns": [
    {
      "include": "#item"
    },
    {
      "include": "#reference-definition"
    },
    {
      "include": "#body-text"
    },
    {
      "include": "#sentence-note"
    },
    {
      "include": "#topic"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#scene-member"
    },
    {
      "include": "#declaration-list"
    },
    {
      "include": "#declaration-optional"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#label"
    },
    {
      "include": "#citation"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "reference-definition": {
      "comment": "참조 1: 본문. 본문 안의 #은 주석이 아닙니다.",
      "match": "^\\s*(참조)\\s+([0-9]+)\\s*(:)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.aha"
        },
        "2": {
          "name": "constant.numeric.reference.aha"
        },
        "3": {
          "name": "punctuation.separator.aha"
        },
        "4": {
          "name": "string.unquoted.reference.aha"
        }
      }
    },
    "body-text": {
      "comment": "본문: 글. 글 안의 #은 주석이 아닙니다.",
      "match": "^\\s*(본문)\\s*(:)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.aha"
        },
        "2": {
          "name": "punctuation.separator.aha"
        },
        "3": {
          "name": "string.unquoted.body.aha"
        }
      }
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.aha"
    },
    "declaration": {
      "comment": "줄을 시작하는 낱말과 선언하는 이름 하나",
      "match": "^\\s*(정의|기준|사건|관측|규칙|낱말|장면)(?:\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*))?(?![\\p{L}\\p{N}\\p{M}_])",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.aha"
        },
        "2": {
          "name": "entity.name.function.aha"
        }
      }
    },
    "label": {
      "comment": "이름 붙은 문장: 깨짐: 컵이 떨어지면 ...",
      "match": "^\\s*([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)\\s*(:)",
      "captures": {
        "1": {
          "name": "entity.name.function.aha"
        },
        "2": {
          "name": "punctuation.separator.aha"
        }
      }
    },
    "citation": {
      "comment": "문장 끝의 (참조 1, 참조 2)",
      "begin": "\\((?=\\s*참조(?![\\p{L}\\p{N}_]))",
      "end": "\\)",
      "name": "meta.citation.aha",
      "patterns": [
        {
          "match": "(참조)\\s+([0-9]+)",
          "captures": {
            "1": {
              "name": "keyword.other.reference.aha"
            },
            "2": {
              "name": "constant.numeric.reference.aha"
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.aha"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "comment": "수와 단위, 정도",
          "match": "(?<![\\p{L}\\p{N}_])([0-9]+)\\s*(밀리초|초|밀리미터|센티미터|미터|%)?(?![\\p{L}\\p{N}_])",
          "captures": {
            "1": {
              "name": "constant.numeric.aha"
            },
            "2": {
              "name": "keyword.other.unit.aha"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(정수|논리|시간|거리|시각|위치|정도|시간축|위치축)(?![\\p{L}\\p{N}_])",
          "name": "support.type.aha"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(참|거짓)(?![\\p{L}\\p{N}_])",
          "name": "constant.language.aha"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(그리고|또는|아님)(?![\\p{L}\\p{N}_])",
          "name": "keyword.operator.logical.aha"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(이면|최소로|곱으로)(?![\\p{L}\\p{N}_])",
          "name": "keyword.control.rule.aha"
        },
        {
          "comment": "지시어: 참조가 필요합니다.",
          "match": "(?<![\\p{L}\\p{N}_])(이렇게|그렇게|저렇게|(?:이것|그것|저것)(?:이|가|은|는|을|를|에게|한테|으로|로)?)(?![\\p{L}\\p{N}_])",
          "name": "variable.language.demonstrative.aha"
        },
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.aha"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.aha"
        },
        {
          "match": "\\+|-|\\*",
          "name": "keyword.operator.arithmetic.aha"
        },
        {
          "match": "@",
          "name": "keyword.operator.anchor.aha"
        },
        {
          "match": "\\?",
          "name": "constant.language.unknown.aha"
        },
        {
          "match": "[:,.]",
          "name": "punctuation.separator.aha"
        }
      ]
    },
    "declaration-list": {
      "comment": "쉼표로 여러 이름을 선언하는 줄. ':'나 '=' 앞까지의 이름이 모두 선언입니다. 괄호 안은 행위의 활용형입니다.",
      "begin": "^\\s*(대상|단위|미지|행위)(?![\\p{L}\\p{N}\\p{M}_])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.declaration.aha"
        }
      },
      "end": "(?=[:=#]|$)",
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)|(?=$)",
          "name": "meta.forms.aha",
          "patterns": [
            {
              "match": ",",
              "name": "punctuation.separator.aha"
            }
          ]
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*",
          "name": "entity.name.function.aha"
        },
        {
          "match": ",",
          "name": "punctuation.separator.aha"
        }
      ]
    },
    "declaration-optional": {
      "comment": "검사·조건·목표. 이름은 바로 뒤에 '='(비교 '=='가 아닌)가 올 때만 이름입니다.",
      "match": "^\\s*(검사|조건|목표)(?![\\p{L}\\p{N}\\p{M}_])(?:\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)(?=\\s*=(?!=)))?",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.aha"
        },
        "2": {
          "name": "entity.name.function.aha"
        }
      }
    },
    "sentence-note": {
      "comment": "문장 뒤의 ': 설명'. 설명은 글이므로 안의 수와 기호를 식처럼 색칠하지 않습니다. 줄 처음 낱말 바로 뒤의 ':'는 문장의 이름입니다.",
      "match": "^(\\s*(?!(?:정의|검사|기준|대상|단위|사건|미지|조건|목표|관측|행위|규칙|참조|본문|주제|낱말|장면)(?![\\p{L}\\p{N}\\p{M}_]))(?:[\\p{L}_][\\p{L}\\p{N}\\p{M}_]*\\s*:\\s*)?[^\\s:#]+\\s[^:#]*)(:)(.*)$",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#label"
            },
            {
              "include": "#citation"
            },
            {
              "include": "#expression"
            }
          ]
        },
        "2": {
          "name": "punctuation.separator.aha"
        },
        "3": {
          "name": "string.unquoted.note.aha"
        }
      }
    },
    "item": {
      "comment": "- 글. 위의 문장·참조·본문에 딸린 줄입니다.",
      "match": "^\\s*(-)(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.list.aha"
        },
        "2": {
          "name": "string.unquoted.item.aha"
        }
      }
    },
    "topic": {
      "comment": "주제 <글>",
      "match": "^\\s*(주제)(?![\\p{L}\\p{N}\\p{M}_])(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.declaration.aha"
        },
        "2": {
          "name": "string.unquoted.topic.aha"
        }
      }
    },
    "scene-member": {
      "comment": "장면 안의 줄: 들여 쓴 '낱말 [이름]: 차원 값, …'. 낱말과 이름을 색칠하고 나머지는 식처럼 읽습니다.",
      "match": "^(\\s+)([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*)(?:\\s+([\\p{L}_][\\p{L}\\p{N}\\p{M}_]*))?\\s*(?=:|$|#)",
      "captures": {
        "2": {
          "name": "entity.name.tag.aha"
        },
        "3": {
          "name": "entity.name.function.aha"
        }
      }
    }
  }
}
