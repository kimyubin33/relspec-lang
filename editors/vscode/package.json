{
  "name": "relspec-kpl",
  "displayName": "RelSpec (KPL)",
  "description": "RelSpec 관계 명세 언어(.kpl): 문법 색칠, 실시간 진단, 판정 결과 표시, 설명, 자동 완성, 정의로 이동",
  "version": "0.10.1",
  "publisher": "kimyubin33",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kimyubin33/relspec-lang.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kpl",
        "aliases": [
          "RelSpec",
          "KPL",
          "kpl"
        ],
        "extensions": [
          ".kpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kpl",
        "scopeName": "source.kpl",
        "path": "./syntaxes/kpl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "RelSpec (KPL)",
      "properties": {
        "kpl.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "`kpl` 실행 파일의 경로입니다. 비워 두면 작업 폴더의 `target/release`, `target/debug`를 차례로 찾고, 없으면 `PATH`의 `kpl`을 씁니다."
        }
      }
    },
    "commands": [
      {
        "command": "kpl.restartServer",
        "title": "RelSpec: 언어 서버 다시 시작"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "test": "node test/grammar.test.js && node test/server.test.js"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}
