{
  "name": "ahaa",
  "displayName": "AHAA (아하)",
  "description": "AHAA(아하) 언어(.aha): 문법 색칠, 실시간 진단, 판정 결과 표시, 설명, 자동 완성, 정의로 이동, 연결망",
  "version": "0.14.0",
  "publisher": "kimyubin33",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kimyubin33/relspec-lang.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "aha",
        "aliases": [
          "AHAA",
          "아하",
          "aha"
        ],
        "extensions": [
          ".aha",
          ".kpl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aha",
        "scopeName": "source.aha",
        "path": "./syntaxes/aha.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "AHAA",
      "properties": {
        "aha.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "`aha` 실행 파일의 경로입니다. 비워 두면 작업 폴더의 `target/release`, `target/debug`를 차례로 찾고, 없으면 `PATH`의 `aha`를 씁니다."
        }
      }
    },
    "commands": [
      {
        "command": "aha.restartServer",
        "title": "AHAA: 언어 서버 다시 시작"
      },
      {
        "command": "aha.showGraph",
        "title": "AHAA: 연결망 보기",
        "icon": "$(type-hierarchy)"
      }
    ],
    "configurationDefaults": {
      "[aha]": {
        "editor.wordWrap": "on",
        "editor.wrappingIndent": "indent",
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.detectIndentation": false
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "aha.showGraph",
          "when": "editorLangId == aha",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "test": "node test/grammar.test.js && node test/server.test.js"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}
